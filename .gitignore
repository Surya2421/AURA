# ==============================================================================
# AURA System .gitignore
# ==============================================================================

# Dependencies
node_modules/
npm-packages-offline-cache/
jspm_packages/
vendor/

# Production Build Artifacts
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.output/

# Logs & Runtime Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Configurations & Secrets
.env
.env.production
.env.development
.env.local
.env.*.local
*.pem

# Test & Quality Reports
coverage/
test-results/
playwright-report/
blob-report/
.nyc_output/
lighthouse-report*.html
lighthouse-report*.json
perf-report*.json

# Visual Artifacts (Temporary screenshot captures)
visual-artifacts/
screenshots/
*.diff.png

# Cache Directories
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
.chrome*

# Operating System Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Temporary Files
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
